<Window x:Class="EspacoFestas.Views.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes" Height="480" Width="820" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <CheckBox x:Name="ChkMostrarInativos" DockPanel.Dock="Top" Content="Mostrar inativos" Margin="0,0,0,8"
                      Checked="ChkMostrarInativos_Changed" Unchecked="ChkMostrarInativos_Changed"/>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="120"/>
                    <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="50"/>
                    <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="120"/>
                    <DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="110"/>
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Nome" />
            <TextBox x:Name="TxtNome" Margin="0,2,0,8"/>
            <TextBlock Text="Endereço"/>
            <TextBox x:Name="TxtEndereco" Margin="0,2,0,8"/>
            <TextBlock Text="Cidade"/>
            <TextBox x:Name="TxtCidade" Margin="0,2,0,8"/>
            <TextBlock Text="UF"/>
            <TextBox x:Name="TxtUf" MaxLength="2" Margin="0,2,0,8"/>
            <TextBlock Text="Telefone"/>
            <TextBox x:Name="TxtTelefone" Margin="0,2,0,8"/>
            <TextBlock Text="CPF"/>
            <TextBox x:Name="TxtCpf" Margin="0,2,0,16"/>

            <Button x:Name="BtnNovo" Content="Novo" Height="32" Margin="0,2" Click="BtnNovo_Click"/>
            <Button x:Name="BtnSalvar" Content="Salvar" Height="32" Margin="0,2" Click="BtnSalvar_Click"/>
            <Button x:Name="BtnAtivarInativar" Content="Inativar" Height="32" Margin="0,2" Click="BtnAtivarInativar_Click"/>

            <TextBlock x:Name="TxtMensagem" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkRed"/>
        </StackPanel>
    </Grid>
</Window>
