<Window x:Class="EspacoFestas.Views.EspeciesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espécies de Pagamento" Height="440" Width="720" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,12,0"
                  SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                <DataGridCheckBoxColumn Header="Parcela" Binding="{Binding PermiteParcelamento}" Width="60"/>
                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Descrição"/>
            <TextBox x:Name="TxtDescricao" Margin="0,2,0,8"/>
            <CheckBox x:Name="ChkPermiteParcelamento" Content="Permite parcelamento" Margin="0,0,0,16"/>

            <Button Content="Novo" Height="32" Margin="0,2" Click="BtnNovo_Click"/>
            <Button Content="Salvar" Height="32" Margin="0,2" Click="BtnSalvar_Click"/>
            <Button x:Name="BtnAtivarInativar" Content="Inativar" Height="32" Margin="0,2" Click="BtnAtivarInativar_Click"/>

            <TextBlock x:Name="TxtMensagem" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkRed"/>
        </StackPanel>
    </Grid>
</Window>
