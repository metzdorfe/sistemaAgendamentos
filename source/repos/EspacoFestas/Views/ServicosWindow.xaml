<Window x:Class="EspacoFestas.Views.ServicosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serviços e Faixas de Preço" Height="520" Width="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Serviços -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Serviços" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Nome"/>
                <TextBox x:Name="TxtServicoNome" Margin="0,2,0,8"/>
                <TextBlock Text="Descrição"/>
                <TextBox x:Name="TxtServicoDescricao" Margin="0,2,0,8" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>
                <Button Content="Novo" Height="30" Margin="0,2" Click="BtnServicoNovo_Click"/>
                <Button Content="Salvar" Height="30" Margin="0,2" Click="BtnServicoSalvar_Click"/>
                <Button x:Name="BtnServicoAtivarInativar" Content="Inativar" Height="30" Margin="0,2" Click="BtnServicoAtivarInativar_Click"/>
                <TextBlock x:Name="TxtServicoMensagem" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkRed"/>
            </StackPanel>
            <DataGrid x:Name="GridServicos" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="GridServicos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Faixas de preço -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" x:Name="TxtFaixasTitulo" Text="Faixas de preço (selecione um serviço)" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Nome da faixa"/>
                        <TextBox x:Name="TxtFaixaNome" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Valor (R$)"/>
                        <TextBox x:Name="TxtFaixaValor" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ordem"/>
                        <TextBox x:Name="TxtFaixaOrdem" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnFaixaNovo" Content="Nova faixa" Width="100" Height="30" Margin="0,0,4,0" Click="BtnFaixaNovo_Click"/>
                    <Button x:Name="BtnFaixaSalvar" Content="Salvar" Width="100" Height="30" Margin="0,0,4,0" Click="BtnFaixaSalvar_Click"/>
                    <Button x:Name="BtnFaixaAtivarInativar" Content="Inativar" Width="100" Height="30" Click="BtnFaixaAtivarInativar_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtFaixaMensagem" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkRed"/>
            </StackPanel>
            <DataGrid x:Name="GridFaixas" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="GridFaixas_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ordem" Binding="{Binding OrdemExibicao}" Width="60"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=C2}" Width="110"/>
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
